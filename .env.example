# ── Supabase ──────────────────────────────────────────────────────────────
# This app is login/signup only — account creation and payment happen on the
# landing page. Only these two values are needed here.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── Low-stock email alerts (serverless function only, never exposed to browser) ─
# Sign up free at resend.com, verify a sending domain, then set these.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
ALERT_FROM_EMAIL=Trakit Alerts <alerts@yourdomain.com>
